#!/bin/sh
set -e

BUN_BIN=""
if command -v bun >/dev/null 2>&1; then
  BUN_BIN="bun"
elif [ -n "$LOCALAPPDATA" ] && [ -x "$LOCALAPPDATA/Volta/tools/image/packages/bun/node_modules/bun/bin/bun.exe" ]; then
  BUN_BIN="$LOCALAPPDATA/Volta/tools/image/packages/bun/node_modules/bun/bin/bun.exe"
elif [ -x "$HOME/.bun/bin/bun" ]; then
  BUN_BIN="$HOME/.bun/bin/bun"
fi

if [ -z "$BUN_BIN" ]; then
  echo "pre-commit: Bun (>= 1.4.4) is required for 'bun fmt' and 'bun lint'." >&2
  echo "Install/upgrade Bun from https://bun.sh and try again." >&2
  exit 1
fi

STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMR)"
if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# Format staged files and re-stage any formatting edits automatically
"$BUN_BIN" fmt --staged

# Lint only if JS/TS files are staged
if printf '%s\n' "$STAGED_FILES" | grep -qE '\.(ts|tsx|js|jsx|mjs|cjs)$'; then
  "$BUN_BIN" lint --staged --max-warnings=0
fi
